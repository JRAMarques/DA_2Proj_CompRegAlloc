PROJECT_NAME           = "Compiler Register Allocation Algorithms"
PROJECT_NUMBER         = "1.0"
PROJECT_BRIEF          = "Register allocation tool mapping variables to limited registers or memory using graph coloring heuristics."
OUTPUT_DIRECTORY       = doxygen_docs
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = YES
OUTPUT_LANGUAGE        = English

# Inputs
INPUT                  = src include
FILE_PATTERNS          = *.cpp *.h
RECURSIVE              = YES
EXCLUDE                = build cmake-build-debug .git

# Source Browsing
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = YES

# Custom Tags
ALIASES += timecomplexity="\n\par Time Complexity:\n"

# Output formats
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
GENERATE_LATEX         = NO

# Extraction
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES

# Warnings
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
